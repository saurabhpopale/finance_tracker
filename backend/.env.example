# Server Port
PORT=8000

# Environment Mode (production / development)
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://dummy_user:dummy_password@cluster0.dummy.mongodb.net/finance_tracker?retryWrites=true&w=majority

# JWT Secret Key (Use a strong, 32+ character random string in production)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production_min_32_chars

# Allowed Frontend URL for CORS (comma-separated if multiple, e.g. https://dummy-finance-tracker.vercel.app,http://localhost:5173)
FRONTEND_URL=https://dummy-finance-tracker.vercel.app

# SMTP Email Configuration (Nodemailer - Gmail address & 16-character App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
